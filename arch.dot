digraph Architecture {
  rankdir=TB;
  node [shape=box, style=rounded, fontname=Arial, fontsize=10];
  edge [fontname=Arial, fontsize=9];

  frontend [label="Frontend: React"];
  backend [label="Backend: FastAPI"];
  database [label="Database: PostgreSQL"];
  cache [label="Cache: Redis"];
  reverse_proxy [label="Reverse Proxy: Nginx"];
  worker [label="Worker: Celery"];

  reverse_proxy -> frontend;
  reverse_proxy -> backend;
  frontend -> backend;
  backend -> database;
  backend -> cache;
  worker -> database;
  worker -> cache;
}